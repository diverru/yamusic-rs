// Экран «Моей волны» как в официальном Android-клиенте. Размеры в dp сняты с оригинала
// на экране 1080×2400 (420 dpi). Фон с волной рисует OpenGL под окном, поэтому окно прозрачное.

import { Icons, WheelCard, Row, ArtistCard, Now, Cover, T } from "common.slint";
import { Player } from "player.slint";
import { MenuSheet, QualitySheet, TimerSheet, TrackSheet, PickSheet, ArtistsSheet } from "sheets.slint";
import { Prof, ProfileScreens, AboutPage, LogoutSheet } from "profile.slint";
import { Pages, PageView, MiniPlayer, PCard, PRow, PBlock, PPage } from "pages.slint";

export { Icons, WheelCard, Row, ArtistCard, Now, Pages, PCard, PRow, PBlock, PPage, Prof, T }

component TabIcon inherits Rectangle {
    in property <image> icon;
    in property <color> tint;
    callback clicked();
    width: 48px;
    height: 48px;
    Image {
        source: icon;
        width: 24px;
        height: 24px;
        colorize: tint;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

component LoginScreen inherits Rectangle {
    in property <string> code;
    in property <string> hint;
    in property <image> logo;
    callback open-login();
    callback retry();

    Image {
        source: logo;
        y: 58px;
        height: 44px;
        width: 187px;
        colorize: #ff0;
    }
    VerticalLayout {
        y: 260px;
        height: 400px;
        alignment: start;
        spacing: 16px;
        padding-left: 32px;
        padding-right: 32px;
        Text {
            text: "Вход в Яндекс";
            color: #fff;
            font-size: 28px;
            font-weight: 700;
            horizontal-alignment: center;
        }
        Text {
            text: root.code == "" ? "…" : root.code;
            color: #ffdb4d;
            font-family: T.display-font;
            font-size: 44px;
            font-weight: 700;
            letter-spacing: 4px;
            horizontal-alignment: center;
        }
        Text {
            text: root.hint;
            color: #ffffff99;
            font-size: 16px;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        Rectangle {
            height: 56px;
            border-radius: 28px;
            background: open-ta.pressed ? #e6e600 : #ff0;
            Text {
                text: "Открыть ya.ru/device";
                color: #000;
                font-size: 17px;
                font-weight: 500;
            }
            open-ta := TouchArea {
                clicked => {
                    root.copy-code();
                    root.open-login();
                }
            }
        }
        if root.code != "": Rectangle {
            height: 56px;
            border-radius: 28px;
            background: copy-ta.pressed ? #ffffff33 : #ffffff1a;
            Text {
                text: root.copied ? "Код скопирован" : "Скопировать код";
                color: #fff;
                font-size: 17px;
                font-weight: 500;
            }
            copy-ta := TouchArea {
                clicked => { root.copy-code(); }
            }
        }
    }
    // У Slint нет функции «положить в буфер», а у поля ввода есть copy().
    clip := TextInput {
        visible: false;
        read-only: true;
        text: root.code;
    }
    property <bool> copied;
    function copy-code() {
        if root.code == "" {
            return;
        }
        clip.select-all();
        clip.copy();
        root.copied = true;
    }
}

export component App inherits Window {
    background: transparent;
    default-font-family: "YS Text";

    in property <Icons> icons;
    in property <bool> logged-in;
    in property <string> login-code;
    in property <string> login-hint;
    // Волну уже запускали: экран показывает исполнителя вместо большой кнопки Play.
    in property <bool> started;
    in property <[WheelCard]> wheel;
    in-out property <length> wheel-offset;

    // 0 волна, 1 «Что послушать», 2 концерты, 3 коллекция.
    in property <int> tab;
    callback tab-clicked(int);
    callback play-wheel(int);
    callback open-login();
    callback retry-login();
    // Плеер что-то поменял: перечитать его состояние.
    callback refresh();

    // Шаг колеса волн: расстояние между центрами соседних карточек.
    out property <length> wheel-spacing: 131px;

    if !root.logged-in: LoginScreen {
        width: root.width;
        height: root.height;
        code: root.login-code;
        hint: root.login-hint;
        logo: root.icons.logo;
        open-login => { root.open-login(); }
        retry => { root.retry-login(); }
    }

    if root.logged-in: Rectangle {
        width: root.width;
        height: root.height;

        // Шапка: логотип по центру и поиск справа. Когда волна играет, вместо логотипа надпись.
        if !root.started: Image {
            source: root.icons.logo;
            x: (parent.width - self.width) / 2;
            y: 58px;
            width: 187px;
            height: 44px;
            colorize: #ff0;
        }
        if root.started && Now.pill != "": Rectangle {
            x: (parent.width - self.width) / 2;
            y: 60px;
            height: 40px;
            width: pill-row.preferred-width;
            border-radius: 20px;
            background: #ffffff1f;
            pill-row := HorizontalLayout {
                padding-left: 16px;
                padding-right: 6px;
                spacing: 4px;
                Text {
                    text: Now.pill;
                    color: #fff;
                    font-size: 15px;
                    font-weight: 500;
                    vertical-alignment: center;
                    overflow: elide;
                    max-width: 240px;
                }
                Rectangle {
                    width: 32px;
                    Path {
                        width: 14px;
                        height: 14px;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        stroke: #fff;
                        stroke-width: 2px;
                        commands: "M5 5l14 14 M19 5L5 19";
                    }
                    TouchArea {
                        clicked => { Now.back-to-wave(); }
                    }
                }
            }
        }
        if root.started && Now.pill == "": Text {
            y: 58px;
            width: parent.width;
            height: 44px;
            text: "Моя волна";
            color: #ff0;
            font-family: "YS Music Headline";
            font-weight: 900;
            font-size: 20px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Rectangle {
            x: parent.width - 52px;
            y: 56.5px;
            width: 48px;
            height: 48px;
            Image {
                source: root.icons.search;
                width: 24px;
                height: 24px;
                colorize: #ffffffe6;
            }
            TouchArea {
                clicked => { Pages.open-search(); }
            }
        }

        if !root.started: Text {
            text: "Моя волна";
            x: 0;
            y: 242px;
            width: parent.width;
            horizontal-alignment: center;
            font-family: "YS Music Headline";
            font-weight: 900;
            font-size: 63px;
            color: #fff;
        }

        // Большая кнопка Play до первого запуска.
        if !root.started: Rectangle {
            x: (parent.width - 96px) / 2;
            y: 342px;
            width: 96px;
            height: 96px;
            border-radius: 48px;
            background: play-ta.pressed ? #e6e600 : #ff0;
            Image {
                source: Now.playing ? root.icons.pause : root.icons.play;
                width: 41.6px;
                height: 41.6px;
                colorize: #000000e6;
            }
            play-ta := TouchArea {
                clicked => { Now.play-pause(); }
            }
        }

        // Во время игры: имя исполнителя, его фото без фона и маленькая обложка.
        if root.started: Rectangle {
            probe := Text {
                visible: false;
                text: Now.artist;
                font-family: "YS Music Headline";
                font-weight: 900;
                font-size: 56px;
            }
            property <length> name-y: Now.cutout.width > 0 ? 120px : 262px;
            TouchArea {
                y: parent.name-y;
                height: 64px;
                clicked => { Now.open-artist(-1); }
            }
            Text {
                y: parent.name-y;
                width: parent.width;
                height: 64px;
                text: Now.artist;
                color: #fff;
                font-family: "YS Music Headline";
                font-weight: 900;
                font-size: 56px * min(1, (parent.width - 32px) / max(1px, probe.preferred-width));
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Image {
                x: 28px;
                y: 130px;
                width: parent.width - 56px;
                height: self.width;
                source: Now.cutout;
                image-fit: contain;
            }
            if Now.cutout.width > 0: TouchArea {
                x: 28px;
                y: 130px;
                width: parent.width - 56px;
                height: self.width;
                clicked => { Now.open-artist(-1); }
            }
            TouchArea {
                x: (parent.width - 96px) / 2;
                y: 342px;
                width: 96px;
                height: 96px;
                Cover {
                    source: Now.cover;
                    radius: 9px;
                }
                clicked => { player.open = true; }
            }
        }

        // Плашка трека. Во время игры слева кружок паузы, справа кружок лайка.
        Rectangle {
            x: root.started ? 92.2px : 32px;
            y: 450.3px;
            width: parent.width - (root.started ? 184.4px : 64px);
            height: 56px;
            border-radius: 28px;
            clip: true;
            background: #ffffff14;
            Rectangle {
                x: 0;
                width: parent.width * clamp(Now.progress, 0, 1);
                height: parent.height;
                background: #ffffff14;
            }
            HorizontalLayout {
                x: root.started ? 16px : 56px;
                width: parent.width - 2 * self.x;
                alignment: center;
                spacing: 6px;
                Text {
                    text: Now.title != "" ? Now.title : Now.status;
                    color: #ffffff99;
                    font-family: "YS Music Headline";
                    font-weight: 700;
                    font-size: 17px;
                    overflow: elide;
                    vertical-alignment: center;
                }
                if Now.explicit: Image {
                    y: (56px - 16px) / 2;
                    width: 16px;
                    height: 16px;
                    source: root.icons.explicit;
                    colorize: #ffffff99;
                }
            }
            TouchArea {
                clicked => {
                    if Now.has-track {
                        player.open = true;
                    }
                }
            }
            if !root.started: Rectangle {
                x: parent.width - 56px;
                width: 56px;
                height: 56px;
                Image {
                    source: Now.liked ? root.icons.liked : root.icons.like;
                    width: 24px;
                    height: 24px;
                    colorize: Now.liked ? #ff0 : #ffffffcc;
                }
                TouchArea {
                    clicked => { Now.like(); }
                }
            }
        }
        if root.started: Rectangle {
            x: 32px;
            y: 450.3px;
            width: 56px;
            height: 56px;
            border-radius: 28px;
            background: #ffffff14;
            Image {
                source: Now.playing ? root.icons.pause : root.icons.play;
                width: 28px;
                height: 28px;
                colorize: #ffffffcc;
            }
            TouchArea {
                clicked => { Now.play-pause(); }
            }
        }
        if root.started: Rectangle {
            x: parent.width - 88px;
            y: 450.3px;
            width: 56px;
            height: 56px;
            border-radius: 28px;
            background: #ffffff14;
            Image {
                source: Now.liked ? root.icons.liked : root.icons.like;
                width: 24px;
                height: 24px;
                colorize: Now.liked ? #ff0 : #ffffffcc;
            }
            TouchArea {
                clicked => { Now.like(); }
            }
        }

        // Колесо волн: карточки стоят на дуге, средняя выше и крупнее.
        wheel-flick := Flickable {
            y: 600px;
            width: parent.width;
            height: parent.height - self.y;
            content-width: self.width + max(0, root.wheel.length - 1) * root.wheel-spacing;
            content-height: self.height;
            content-x <=> root.wheel-offset;

            for card[i] in root.wheel: card-box := Rectangle {
                // Сдвиг от центра экрана в dp и подъём по дуге радиуса 277.5 dp.
                property <float> d: abs((i * root.wheel-spacing + wheel-flick.content-x) / 1px);
                property <float> arc: min(self.d, 277);
                property <float> scale: 1 - 0.107 * min(self.d / 131, 1);
                property <length> size: 64px * self.scale;
                x: wheel-flick.width / 2 + i * root.wheel-spacing - 67px;
                // Центр обложки на 40 px ниже верха карточки.
                y: 16.8px + (277.5 - sqrt(277.5 * 277.5 - self.arc * self.arc)) * 1px;
                width: 134px;
                height: 200px;

                Image {
                    y: 47px;
                    width: 134px;
                    height: 160px;
                    source: card.blob;
                }
                Rectangle {
                    x: (parent.width - parent.size) / 2;
                    y: 40px - parent.size / 2;
                    width: parent.size;
                    height: parent.size;
                    border-radius: card.round ? self.width / 2 : 8px * parent.scale;
                    clip: true;
                    background: #ffffff14;
                    Image {
                        width: parent.width;
                        height: parent.height;
                        source: card.cover;
                        image-fit: cover;
                    }
                }
                Rectangle {
                    x: (parent.width - parent.size) / 2;
                    y: 40px - parent.size / 2;
                    width: parent.size;
                    height: parent.size;
                    border-radius: card.round ? self.width / 2 : 8px * parent.scale;
                    border-width: 1px;
                    border-color: #ffffff33;
                }
                VerticalLayout {
                    x: 5px;
                    y: 40px + parent.size / 2 + 3px;
                    width: 124px;
                    alignment: start;
                    spacing: 2px;
                    if card.description != "": Text {
                        text: card.description;
                        color: #ffffff80;
                        font-size: 12px * card-box.scale;
                        font-weight: 500;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        text: card.name;
                        color: #fff;
                        font-size: 15px * card-box.scale;
                        font-weight: 500;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                        overflow: elide;
                        max-height: 40px * card-box.scale;
                    }
                }
                TouchArea {
                    clicked => { root.play-wheel(i); }
                }
            }
        }

    }

    if root.logged-in && Pages.shown: PageView {
        width: root.width;
        height: root.height;
        icons: root.icons;
        bottom: Now.has-track ? 176px : 100px;
    }

    if root.logged-in && Pages.shown && Prof.screen > 0: ProfileScreens {
        width: root.width;
        height: root.height;
        icons: root.icons;
        bottom: Now.has-track ? 176px : 100px;
    }

    if root.logged-in && Pages.shown && Now.has-track && !Pages.viewer-open: MiniPlayer {
        x: 12px;
        y: root.height - 75.8px - 8px - self.height;
        width: root.width - 24px;
        icons: root.icons;
        open => { player.open = true; }
    }

    // Нижние вкладки: на волне тёмные, на страницах белые.
    if root.logged-in && !Pages.viewer-open: Rectangle {
        y: root.height - 83.8px;
        height: 83.8px;
        background: Pages.shown ? T.bg : transparent;
        HorizontalLayout {
            y: 8px;
            height: 48px;
            padding-left: 27.8px;
            padding-right: 27.8px;
            alignment: space-between;
            TabIcon {
                icon: root.icons.tab-wave;
                tint: root.tab == 0 ? (Pages.shown ? T.fg : #ff0) : (Pages.shown ? T.fg.with-alpha(0.40) : #ffffff80);
                clicked => {
                    Prof.screen = 0;
                    root.tab-clicked(0);
                }
            }
            TabIcon {
                icon: root.icons.tab-home;
                tint: root.tab == 1 ? T.fg : (Pages.shown ? T.fg.with-alpha(0.40) : #ffffff80);
                clicked => {
                    Prof.screen = 0;
                    root.tab-clicked(1);
                }
            }
            TabIcon {
                icon: root.icons.tab-concerts;
                tint: root.tab == 2 ? T.fg : (Pages.shown ? T.fg.with-alpha(0.40) : #ffffff80);
                clicked => {
                    Prof.screen = 0;
                    root.tab-clicked(2);
                }
            }
            TabIcon {
                icon: root.icons.tab-collection;
                tint: root.tab == 3 ? T.fg : (Pages.shown ? T.fg.with-alpha(0.40) : #ffffff80);
                clicked => {
                    Prof.screen = 0;
                    root.tab-clicked(3);
                }
            }
        }
    }

    player := Player {
        width: root.width;
        height: root.height;
        open-menu => { menu.open = true; }
        open-timer => { timer.open = true; }
        open-quality => { quality.open = true; }
    }
    menu := MenuSheet {
        width: root.width;
        height: root.height;
        lyrics => {
            Now.lyrics-mode = true;
            player.lyrics-full = true;
        }
        playlists => { player.show-playlists(); }
    }
    TrackSheet {
        width: root.width;
        height: root.height;
    }
    PickSheet {
        width: root.width;
        height: root.height;
    }
    ArtistsSheet {
        width: root.width;
        height: root.height;
    }
    quality := QualitySheet {
        width: root.width;
        height: root.height;
    }
    timer := TimerSheet {
        width: root.width;
        height: root.height;
    }

    if Prof.about-open: AboutPage {
        width: root.width;
        height: root.height;
    }
    LogoutSheet {
        width: root.width;
        height: root.height;
    }

    if Now.toast != "": Rectangle {
        x: 16px;
        y: root.height - self.height - (player.open ? 40px : Now.has-track ? 168px : 100px);
        width: root.width - 32px;
        height: max(48px, toast-text.preferred-height + 24px);
        border-radius: 14px;
        background: #333336;
        toast-text := Text {
            x: 16px;
            width: parent.width - 32px;
            text: Now.toast;
            color: #fff;
            font-size: 15px;
            wrap: word-wrap;
        }
    }

    // «Назад» закрывает то, что открыто сверху; если ничего, Android сворачивает приложение.
    back := FocusScope {
        width: 0;
        height: 0;
        key-pressed(e) => {
            if e.text != Key.Back {
                return reject;
            }
            if Prof.logout-open {
                Prof.logout-open = false;
            } else if Prof.about-open {
                Prof.about-open = false;
            } else if Pages.pick-open {
                Pages.pick-open = false;
            } else if Pages.menu-open {
                Pages.menu-open = false;
            } else if Pages.viewer-open {
                Pages.viewer-open = false;
            } else if menu.open {
                menu.open = false;
            } else if quality.open {
                quality.open = false;
            } else if timer.open {
                timer.open = false;
            } else if player.lyrics-full {
                player.lyrics-full = false;
            } else if player.queue-open {
                player.queue-open = false;
            } else if player.open {
                player.open = false;
            } else if Prof.screen > 0 {
                Prof.back();
            } else if Pages.shown {
                Pages.back();
            } else {
                return reject;
            }
            accept
        }
    }
    forward-focus: back;

    public function refocus() {
        back.focus();
    }
}
